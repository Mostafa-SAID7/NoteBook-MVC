@{
    ViewData["Title"] = "Page Not Found";
}

<div class="position-relative w-full min-h-screen overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);">
    <!-- Animated Background -->
    <div class="position-absolute inset-0 pointer-events-none">
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 200px; height: 200px; background: #1a1a1a; top: -50px; right: -50px; opacity: 0.05;"></div>
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 150px; height: 150px; background: #1a1a1a; bottom: 10%; left: 5%; opacity: 0.05; animation-delay: 1s;"></div>
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 100px; height: 100px; background: #666; top: 20%; left: 10%; opacity: 0.05; animation-delay: 2s;"></div>
    </div>

    <!-- NotFound Content -->
    <div class="position-relative d-flex flex-column align-items-center justify-content-center min-h-screen py-8 px-4 animate-slide-up" style="z-index: 1;">
        <div class="text-center max-w-container">
            <!-- 404 Number -->
            <div class="mb-4 animate-scale-in">
                <span class="font-bold" style="font-size: 6rem; background: linear-gradient(135deg, #1a1a1a 0%, #666 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; line-height: 1; letter-spacing: -0.05em;">404</span>
            </div>

            <!-- Title -->
            <h1 class="text-3xl font-bold text-primary mb-2 animate-slide-up animate-delay-100">Page Not Found</h1>
            <p class="text-lg text-secondary mb-6 opacity-75 animate-slide-up animate-delay-200">The page you're looking for doesn't exist</p>

            <!-- Requested Path -->
            <div class="mb-6 animate-slide-up animate-delay-300">
                <p class="text-sm text-secondary m-0">
                    Requested path: <code class="bg-gray-100 px-2 py-1 rounded text-sm" style="font-family: monospace; color: #666; word-break: break-all;">@ViewData["RequestPath"]</code>
                </p>
            </div>

            <!-- Help Information -->
            <div class="bg-gray-100 p-6 rounded shadow-sm mb-6 text-left animate-slide-up animate-delay-400" style="border-left: 4px solid #1a1a1a; max-width: 600px; margin-left: auto; margin-right: auto;">
                <div class="d-flex gap-3">
                    <i class="fas fa-lightbulb text-primary" style="font-size: 1.2rem; margin-top: 4px;"></i>
                    <div>
                        <h3 class="font-semibold mb-3 text-primary">What can you do?</h3>
                        <ul class="m-0 p-0" style="list-style: none;">
                            <li class="text-secondary text-sm mb-2 line-height-relaxed pl-6 position-relative"><span class="position-absolute font-bold text-primary" style="left: 0;">✓</span>Check the URL and make sure it's correct</li>
                            <li class="text-secondary text-sm mb-2 line-height-relaxed pl-6 position-relative"><span class="position-absolute font-bold text-primary" style="left: 0;">✓</span>Return to the home page and try browsing from there</li>
                            <li class="text-secondary text-sm mb-2 line-height-relaxed pl-6 position-relative"><span class="position-absolute font-bold text-primary" style="left: 0;">✓</span>Use the navigation menu to find what you're looking for</li>
                            <li class="text-secondary text-sm mb-0 line-height-relaxed pl-6 position-relative"><span class="position-absolute font-bold text-primary" style="left: 0;">✓</span>Contact support if you believe this is an error</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-4 justify-content-center flex-wrap animate-slide-up animate-delay-500">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i>Back to Home
                </a>
                <a href="#" onclick="history.back(); return false;" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>Go Back
                </a>
            </div>

            <!-- Help Footer -->
            <div class="mt-8 text-center">
                <p class="text-secondary text-sm m-0">
                    Lost? <a href="/" class="text-primary" style="text-decoration: underline;">Start from home</a> or <a href="/privacy" class="text-primary" style="text-decoration: underline;">check our policies</a>
                </p>
            </div>
        </div>
    </div>
</div>
