@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-container mx-auto py-8">
    <h1 class="font-bold text-3xl mb-6">@ViewData["Title"]</h1>

    <div class="d-flex flex-column gap-6">
        <section>
            <h2 class="font-bold text-xl mb-3">Introduction</h2>
            <p class="text-secondary mb-4">
                NoteBook respects your privacy. This policy explains how we collect, use, and protect your data.
            </p>
        </section>

        <section>
            <h2 class="font-bold text-xl mb-3">Information We Collect</h2>
            <p class="text-secondary mb-4">
                When you use NoteBook, we collect:
            </p>
            <ul class="text-secondary mb-4 ml-4">
                <li class="mb-2">• Account information (username, email)</li>
                <li class="mb-2">• Notes and content you create</li>
                <li class="mb-2">• Usage patterns and analytics</li>
                <li class="mb-2">• Device and browser information</li>
            </ul>
        </section>

        <section>
            <h2 class="font-bold text-xl mb-3">How We Use Your Information</h2>
            <p class="text-secondary mb-4">
                Your information is used to:
            </p>
            <ul class="text-secondary mb-4 ml-4">
                <li class="mb-2">• Provide and improve the NoteBook service</li>
                <li class="mb-2">• Authenticate your account</li>
                <li class="mb-2">• Send important notifications</li>
                <li class="mb-2">• Analyze usage and fix issues</li>
            </ul>
        </section>

        <section>
            <h2 class="font-bold text-xl mb-3">Data Protection</h2>
            <p class="text-secondary mb-4">
                We implement industry-standard security measures including:
            </p>
            <ul class="text-secondary mb-4 ml-4">
                <li class="mb-2">• Encryption of data in transit and at rest</li>
                <li class="mb-2">• Secure authentication with JWT tokens</li>
                <li class="mb-2">• Regular security audits and updates</li>
                <li class="mb-2">• Limited access to sensitive information</li>
            </ul>
        </section>

        <section>
            <h2 class="font-bold text-xl mb-3">Your Rights</h2>
            <p class="text-secondary mb-4">
                You have the right to:
            </p>
            <ul class="text-secondary mb-4 ml-4">
                <li class="mb-2">• Access your personal data</li>
                <li class="mb-2">• Correct inaccurate information</li>
                <li class="mb-2">• Request deletion of your data</li>
                <li class="mb-2">• Opt-out of non-essential communications</li>
            </ul>
        </section>

        <section>
            <h2 class="font-bold text-xl mb-3">Contact Us</h2>
            <p class="text-secondary">
                If you have questions about this privacy policy, please contact us at privacy@notebook.app
            </p>
        </section>

        <section class="border-top pt-6 mt-6">
            <p class="text-secondary text-sm">
                Last updated: June 2026
            </p>
        </section>
    </div>
</div>
