@model NoteBook.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex flex-column align-items-center gap-6 py-12 min-h-screen justify-content-center">
    <div class="text-center">
        <h1 class="text-3xl font-bold text-primary mb-3">Error.</h1>
        <h2 class="text-xl text-secondary mb-6">An error occurred while processing your request.</h2>

        @if (Model.ShowRequestId)
        {
            <p class="text-sm mb-6">
                <strong>Request ID:</strong> 
                <code class="bg-gray-100 px-2 py-1 rounded" style="font-family: monospace;">@Model.RequestId</code>
            </p>
        }

        <div class="bg-gray-100 p-6 rounded mb-6 text-left max-w-600">
            <h3 class="font-bold mb-3">Development Mode Information</h3>
            <p class="text-sm text-secondary mb-3">
                Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <p class="text-sm text-secondary mb-3">
                <strong>Note:</strong> The Development environment shouldn't be enabled for deployed applications as it can result in displaying sensitive information from exceptions to end users.
            </p>
            <p class="text-sm text-secondary">
                For local debugging, set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong> and restart the app.
            </p>
        </div>

        <div class="d-flex gap-4 justify-content-center">
            <a href="/" class="px-4 py-2 bg-black text-white rounded cursor-pointer" style="text-decoration: none;">
                ← Back to Home
            </a>
        </div>
    </div>
</div>

<style>
    .max-w-600 {
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }
</style>
