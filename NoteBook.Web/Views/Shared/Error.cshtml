@model NoteBook.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="position-relative w-full min-h-screen overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);">
    <!-- Animated Background -->
    <div class="position-absolute inset-0 pointer-events-none">
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 200px; height: 200px; background: #1a1a1a; top: -50px; right: -50px; opacity: 0.05;"></div>
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 150px; height: 150px; background: #1a1a1a; bottom: 10%; left: 5%; opacity: 0.05; animation-delay: 1s;"></div>
        <div class="position-absolute rounded-full opacity-0 animate-float" style="width: 100px; height: 100px; background: #666; top: 20%; left: 10%; opacity: 0.05; animation-delay: 2s;"></div>
    </div>

    <!-- Error Content -->
    <div class="position-relative d-flex flex-column align-items-center justify-content-center min-h-screen py-8 px-4 animate-slide-up" style="z-index: 1;">
        <div class="text-center max-w-container">
            <!-- Icon -->
            <div class="mb-4 animate-bounce">
                <i class="fas fa-exclamation-triangle animate-pulse" style="font-size: 4rem; color: #1a1a1a;"></i>
            </div>

            <!-- Title -->
            <h1 class="text-3xl font-bold text-primary mb-2 animate-slide-up animate-delay-100">Oops!</h1>
            <p class="text-lg text-secondary mb-6 opacity-75 animate-slide-up animate-delay-200">Something went wrong</p>

            <!-- Error Message -->
            <h2 class="text-xl text-secondary mb-6 animate-slide-up animate-delay-300">An error occurred while processing your request.</h2>

            <!-- Request ID -->
            @if (Model.ShowRequestId)
            {
                <div class="mb-6 animate-slide-up animate-delay-400">
                    <p class="text-sm text-secondary mb-3"><strong>Request ID:</strong></p>
                    <code class="d-inline-block px-4 py-2 bg-gray-100 rounded text-sm animate-fade-in animate-delay-500" style="border: 1px solid #ddd; word-break: break-all; font-family: monospace;">@Model.RequestId</code>
                </div>
            }

            <!-- Info Box -->
            <div class="bg-gray-100 p-6 rounded shadow-sm mb-6 text-left animate-slide-up animate-delay-500" style="border-left: 4px solid #1a1a1a; max-width: 600px; margin-left: auto; margin-right: auto;">
                <div class="d-flex gap-3 mb-4">
                    <i class="fas fa-info-circle text-primary" style="font-size: 1.2rem; margin-top: 4px;"></i>
                    <div>
                        <h3 class="font-semibold mb-3 text-primary">Development Mode</h3>
                        <p class="text-secondary text-sm mb-3 line-height-relaxed">The Development environment provides detailed error information to help with debugging.</p>
                        <p class="text-secondary text-sm mb-3 line-height-relaxed"><strong>⚠️ Security Note:</strong> Don't enable Development mode in production as it may expose sensitive information.</p>
                        <p class="text-secondary text-sm mb-0 line-height-relaxed">To enable debugging locally, set <code class="bg-white px-2 py-1 rounded" style="font-family: monospace; font-size: 0.85em;">ASPNETCORE_ENVIRONMENT=Development</code> and restart the app.</p>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-4 justify-content-center flex-wrap animate-slide-up animate-delay-600">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i>Back to Home
                </a>
                <button onclick="location.reload()" class="btn btn-secondary">
                    <i class="fas fa-redo"></i>Try Again
                </button>
            </div>

            <!-- Help Footer -->
            <div class="mt-8 text-center">
                <p class="text-secondary text-sm m-0">
                    Need help? <a href="/" class="text-primary" style="text-decoration: underline;">Contact Support</a>
                </p>
            </div>
        </div>
    </div>
</div>
