<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1a1a" />
    <title>@ViewData["Title"] - NoteBook</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    
    <!-- Design System CSS - Main entry point includes all modules and Font Awesome -->
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NoteBook.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_Header")

    <main role="main" class="container py-8">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <!-- Application JavaScript -->
    <!-- Core utilities and AJAX -->
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script src="~/js/http.js" asp-append-version="true"></script>
    <script src="~/js/ajax-form.js" asp-append-version="true"></script>
    <!-- Icons Management -->
    <script src="~/js/icons.js" asp-append-version="true"></script>
    <!-- UI Components -->
    <script src="~/js/alerts.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/tabs.js" asp-append-version="true"></script>
    <script src="~/js/collapse.js" asp-append-version="true"></script>
    <!-- Form utilities -->
    <script src="~/js/form-validation.js" asp-append-version="true"></script>
    <!-- Site-specific -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
