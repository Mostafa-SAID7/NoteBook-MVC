<!-- Header Partial - Site branding and main navigation -->
<header class="border-bottom">
    <div class="container d-flex justify-content-between align-items-center px-4 py-4">
        <!-- Logo/Brand -->
        <div class="d-flex align-items-center gap-4">
            <a class="text-primary font-bold text-lg" href="/" style="text-decoration: none; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-book" style="font-size: 1.5rem;"></i>
                <span>NoteBook</span>
            </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="d-none-sm d-flex gap-6">
            <a class="text-primary" href="/" style="text-decoration: none; transition: opacity 0.3s;">
                <i class="fas fa-home" style="margin-right: 6px;"></i>Home
            </a>
            <a class="text-primary" href="/privacy" style="text-decoration: none; transition: opacity 0.3s;">
                <i class="fas fa-shield-alt" style="margin-right: 6px;"></i>Privacy
            </a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="d-none d-block-sm cursor-pointer" 
                aria-label="Toggle navigation"
                style="background: none; border: 1px solid #ccc; border-radius: 4px; padding: 8px 12px; font-size: 1.2rem;">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <nav id="mobile-menu" class="d-none d-block-sm overflow-hidden transition-base" style="max-height: 0; background: #f5f5f5;">
        <div class="container px-4 py-4">
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
                <li>
                    <a class="text-primary" href="/" style="text-decoration: none;">
                        <i class="fas fa-home" style="margin-right: 8px;"></i>Home
                    </a>
                </li>
                <li>
                    <a class="text-primary" href="/privacy" style="text-decoration: none;">
                        <i class="fas fa-shield-alt" style="margin-right: 8px;"></i>Privacy
                    </a>
                </li>
            </ul>
        </div>
    </nav>
</header>

<script>
    // Mobile menu toggle
    document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        let isOpen = false;

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', function() {
                isOpen = !isOpen;
                if (isOpen) {
                    mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
                } else {
                    mobileMenu.style.maxHeight = '0';
                }
            });
        }
    });
</script>
